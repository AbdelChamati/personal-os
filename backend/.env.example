# Backend Environment Configuration

# Server port
PORT=3001

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node environment
NODE_ENV=development

# Database (relative to the backend directory)
DATABASE_PATH=./personal-os.db

# Browser application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# OAuth callback URLs to register with each provider:
# http://localhost:3001/api/auth/oauth/google/callback
# http://localhost:3001/api/auth/oauth/microsoft/callback
# http://localhost:3001/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP email delivery for password reset links
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Personal OS <no-reply@example.com>"

# Twilio SMS delivery for reminders (phone numbers must use E.164 format, e.g. +15551234567)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
